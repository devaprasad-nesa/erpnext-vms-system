Form Dict: {'doc': {'name': 'customer-dashboard', 'owner': 'Administrator', 'creation': '2026-09-21 10:25:38.795269', 'modified': '2026-09-24 11:04:07.344727', 'modified_by': 'Administrator', 'docstatus': 0, 'idx': 0, 'title': 'customer dashboard', 'route': 'customer-home', 'dynamic_route': 1, 'published': 1, 'module': 'Vms User', 'content_type': 'HTML', 'dynamic_template': 1, 'main_section_html': '\n<div class="container my-5">\n\n    <h2>Customer Dashboard</h2>\n\n    <p id="welcome-message">\n        Welcome to your VMS account\n    </p>\n\n    <div class="row g-4">\n\n        <!-- My Profile -->\n        <div class="col-md-6 col-lg-3">\n            <div class="card h-100 p-3">\n                <h4>My Profile</h4>\n\n                <p class="text-muted">\n                    View and manage your profile.\n                </p>\n\n                <a href="/customer-profile"\n                   class="btn btn-outline-primary mt-auto">\n                    View Profile\n                </a>\n            </div>\n        </div>\n\n        <!-- My Vehicles -->\n        <div class="col-md-6 col-lg-3">\n            <div class="card h-100 p-3">\n\n                <h4>\n                    <i class="fa fa-car"></i>\n                    My Vehicles\n                </h4>\n\n                <p class="text-muted">\n                    Register and manage your vehicles.\n                </p>\n\n                <a href="/my-vehicles"\n                   class="btn btn-primary mt-auto">\n                    View Vehicles\n                </a>\n\n                <a href="/vehicle-register"\n                   class="btn btn-outline-primary mt-2">\n                    <i class="fa fa-plus"></i>\n                    Register New Vehicle\n                </a>\n\n            </div>\n        </div>\n\n        <!-- My Service Bookings -->\n        <div class="col-md-6 col-lg-3">\n            <div class="card h-100 p-3">\n                <h4>My Service Bookings</h4>\n\n                <p class="text-muted">\n                    View your service bookings.\n                </p>\n\n                <a href="/vehicle-service-registration"\n                   class="btn btn-outline-primary mt-auto">\n                    View Bookings\n                </a>\n            </div>\n        </div>\n\n        <!-- My Invoices -->\n        <div class="col-md-6 col-lg-3">\n            <div class="card h-100 p-3">\n                <h4>My Invoices</h4>\n\n                <p class="text-muted">\n                    View your invoices and payments.\n                </p>\n\n                <a href="/my-invoices"\n                   class="btn btn-outline-primary mt-auto">\n                    View Invoices\n                </a>\n            </div>\n        </div>\n\n    </div>\n</div>', 'insert_style': 1, 'text_align': 'Left', 'full_width': 1, 'show_title': 0, 'show_sidebar': 0, 'enable_comments': 0, 'doctype': 'Web Page', 'page_blocks': [], '__onload': {'is_website_generator': True, 'published': 1}, 'css': '/* ================================================================\n   VMS CUSTOMER HOME\n   Violet + Glassmorphism Theme\n================================================================ */\n\n\n/* ================================================================\n   PAGE BACKGROUND\n================================================================ */\n\n.customer-home-page {\n\n    min-height: 100vh;\n\n    padding: 30px 0 60px;\n\n    background:\n        radial-gradient(circle at 10% 10%,\n            rgba(168, 85, 247, 0.45),\n            transparent 30%),\n\n        radial-gradient(circle at 90% 15%,\n            rgba(124, 58, 237, 0.40),\n            transparent 30%),\n\n        radial-gradient(circle at 50% 90%,\n            rgba(192, 132, 252, 0.30),\n            transparent 35%),\n\n        linear-gradient(135deg,\n            #160b2e 0%,\n            #28104d 40%,\n            #3b176d 70%,\n            #170a30 100%);\n\n    background-attachment: fixed;\n\n    color: #ffffff;\n\n}\n\n\n/* ================================================================\n   MAIN CONTAINER\n================================================================ */\n\n.customer-home-container {\n\n    max-width: 1250px;\n\n}\n\n\n/* ================================================================\n   GLASS CARD\n================================================================ */\n\n.glass-card {\n\n    background:\n        linear-gradient(135deg,\n            rgba(255, 255, 255, 0.14),\n            rgba(255, 255, 255, 0.06));\n\n    border:\n\n        1px solid rgba(255, 255, 255, 0.18);\n\n    backdrop-filter:\n        blur(18px);\n\n    -webkit-backdrop-filter:\n        blur(18px);\n\n    box-shadow:\n\n        0 20px 45px rgba(0, 0, 0, 0.25),\n\n        inset 0 1px 0 rgba(255, 255, 255, 0.10);\n\n}\n\n\n/* ================================================================\n   HERO\n================================================================ */\n\n.customer-hero {\n\n    position: relative;\n\n    overflow: hidden;\n\n    border-radius: 24px;\n\n    padding: 32px;\n\n}\n\n\n/* Decorative glow */\n\n.customer-hero::before {\n\n    content: "";\n\n    position: absolute;\n\n    width: 250px;\n\n    height: 250px;\n\n    border-radius: 50%;\n\n    background:\n        rgba(192, 132, 252, 0.30);\n\n    filter:\n        blur(50px);\n\n    top: -100px;\n\n    right: -70px;\n\n}\n\n\n.customer-hero::after {\n\n    content: "";\n\n    position: absolute;\n\n    width: 180px;\n\n    height: 180px;\n\n    border-radius: 50%;\n\n    background:\n        rgba(124, 58, 237, 0.25);\n\n    filter:\n        blur(45px);\n\n    bottom: -90px;\n\n    left: 15%;\n\n}\n\n\n/* Hero content */\n\n.customer-hero-content {\n\n    position: relative;\n\n    z-index: 2;\n\n    display: flex;\n\n    justify-content: space-between;\n\n    align-items: center;\n\n    gap: 25px;\n\n}\n\n\n.customer-hero-text h2 {\n\n    margin:\n\n        12px 0 8px;\n\n    color: #ffffff;\n\n    font-size: 30px;\n\n    font-weight: 700;\n\n}\n\n\n.customer-hero-text p {\n\n    margin: 0;\n\n    color:\n        rgba(255, 255, 255, 0.72);\n\n    font-size: 15px;\n\n}\n\n\n/* ================================================================\n   PORTAL BADGE\n================================================================ */\n\n.portal-badge {\n\n    display: inline-block;\n\n    padding: 7px 12px;\n\n    border-radius: 999px;\n\n    background:\n        rgba(255, 255, 255, 0.15);\n\n    border:\n        1px solid rgba(255, 255, 255, 0.25);\n\n    color: #ffffff;\n\n    font-size: 11px;\n\n    font-weight: 700;\n\n    letter-spacing: 1px;\n\n}\n\n\n/* ================================================================\n   HERO BUTTONS\n================================================================ */\n\n.customer-hero-actions {\n\n    display: flex;\n\n    flex-wrap: wrap;\n\n    justify-content: flex-end;\n\n    gap: 10px;\n\n}\n\n\n.customer-btn {\n\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    min-height: 40px;\n\n    padding:\n        9px 16px;\n\n    border-radius: 10px;\n\n    font-size: 13px;\n\n    font-weight: 700;\n\n    text-decoration: none;\n\n    transition:\n        all 0.2s ease;\n\n}\n\n\n.customer-btn-light {\n\n    background:\n        rgba(255, 255, 255, 0.92);\n\n    color: #5b21b6;\n\n    border:\n        1px solid rgba(255, 255, 255, 0.95);\n\n}\n\n\n.customer-btn-light:hover {\n\n    background: #ffffff;\n\n    color: #4c1d95;\n\n    transform:\n        translateY(-2px);\n\n    text-decoration: none;\n\n}\n\n\n.customer-btn-outline {\n\n    background:\n        rgba(255, 255, 255, 0.08);\n\n    color: #ffffff;\n\n    border:\n        1px solid rgba(255, 255, 255, 0.45);\n\n}\n\n\n.customer-btn-outline:hover {\n\n    background:\n        rgba(255, 255, 255, 0.18);\n\n    color: #ffffff;\n\n    transform:\n        translateY(-2px);\n\n    text-decoration: none;\n\n}\n\n\n/* ================================================================\n   CUSTOMER CARDS\n================================================================ */\n\n.customer-card {\n\n    overflow: hidden;\n\n    border-radius: 20px;\n\n}\n\n\n.customer-card-header {\n\n    display: flex;\n\n    justify-content: space-between;\n\n    align-items: center;\n\n    gap: 10px;\n\n    padding:\n        18px 20px;\n\n    border-bottom:\n        1px solid rgba(255, 255, 255, 0.12);\n\n    background:\n        rgba(255, 255, 255, 0.045);\n\n}\n\n\n.customer-card-header h5 {\n\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 17px;\n\n    font-weight: 700;\n\n}\n\n\n.customer-card-header .booking-title {\n\n    color:\n        #e9d5ff;\n\n}\n\n\n.customer-card-body {\n\n    padding: 20px;\n\n}\n\n\n/* ================================================================\n   PROFILE\n================================================================ */\n\n.profile-field {\n\n    margin-bottom: 18px;\n\n}\n\n\n.profile-field:last-child {\n\n    margin-bottom: 0;\n\n}\n\n\n.profile-label {\n\n    display: block;\n\n    margin-bottom: 5px;\n\n    color:\n        rgba(255, 255, 255, 0.52);\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n    letter-spacing: 1px;\n\n    text-transform: uppercase;\n\n}\n\n\n.profile-field p {\n\n    margin: 0;\n\n    color:\n        rgba(255, 255, 255, 0.88);\n\n    font-size: 14px;\n\n    font-weight: 500;\n\n    word-break: break-word;\n\n}\n\n\n/* ================================================================\n   SMALL BUTTON\n================================================================ */\n\n.customer-small-btn {\n\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    padding:\n        7px 12px;\n\n    border-radius: 8px;\n\n    background:\n        rgba(196, 181, 253, 0.12);\n\n    border:\n        1px solid rgba(196, 181, 253, 0.30);\n\n    color:\n        #ddd6fe;\n\n    font-size: 12px;\n\n    font-weight: 700;\n\n    text-decoration: none;\n\n    cursor: pointer;\n\n    transition:\n        all 0.2s ease;\n\n}\n\n\n.customer-small-btn:hover {\n\n    background:\n        rgba(196, 181, 253, 0.22);\n\n    color: #ffffff;\n\n    text-decoration: none;\n\n    transform:\n        translateY(-1px);\n\n}\n\n\n/* ================================================================\n   FORM\n================================================================ */\n\n.customer-form-group {\n\n    margin-bottom: 18px;\n\n}\n\n\n.customer-form-group label {\n\n    display: block;\n\n    margin-bottom: 7px;\n\n    color:\n        rgba(255, 255, 255, 0.85);\n\n    font-size: 13px;\n\n    font-weight: 600;\n\n}\n\n\n.customer-form-group small {\n\n    display: block;\n\n    margin-top: 6px;\n\n    color:\n        rgba(255, 255, 255, 0.48);\n\n    font-size: 11px;\n\n}\n\n\n/* ================================================================\n   FORM CONTROLS\n================================================================ */\n\n.customer-form-control {\n\n    width: 100%;\n\n    min-height: 44px;\n\n    padding:\n        10px 13px;\n\n    border-radius: 10px;\n\n    border:\n        1px solid rgba(255, 255, 255, 0.18);\n\n    background:\n        rgba(255, 255, 255, 0.08);\n\n    color: #ffffff;\n\n    outline: none;\n\n    font-size: 13px;\n\n    transition:\n        all 0.2s ease;\n\n}\n\n\n.customer-form-control:focus {\n\n    border-color:\n        rgba(216, 180, 254, 0.75);\n\n    background:\n        rgba(255, 255, 255, 0.12);\n\n    box-shadow:\n        0 0 0 3px rgba(168, 85, 247, 0.18);\n\n}\n\n\n.customer-form-control::placeholder {\n\n    color:\n        rgba(255, 255, 255, 0.40);\n\n}\n\n\n/* Select options */\n\n.customer-form-control option {\n\n    background: #291044;\n\n    color: #ffffff;\n\n}\n\n\n/* Date input calendar */\n\n.customer-form-control[type="date"] {\n\n    color-scheme: dark;\n\n}\n\n\n/* ================================================================\n   BOOKING BUTTON\n================================================================ */\n\n.customer-submit-btn {\n\n    width: 100%;\n\n    min-height: 46px;\n\n    padding:\n        10px 16px;\n\n    border: 0;\n\n    border-radius: 11px;\n\n    background:\n        linear-gradient(135deg,\n            #7c3aed,\n            #a855f7);\n\n    color: #ffffff;\n\n    font-size: 13px;\n\n    font-weight: 700;\n\n    cursor: pointer;\n\n    box-shadow:\n        0 8px 20px rgba(124, 58, 237, 0.30);\n\n    transition:\n        all 0.2s ease;\n\n}\n\n\n.customer-submit-btn:hover {\n\n    transform:\n        translateY(-2px);\n\n    box-shadow:\n        0 12px 26px rgba(124, 58, 237, 0.40);\n\n}\n\n\n.customer-submit-btn:disabled {\n\n    opacity: 0.55;\n\n    cursor: not-allowed;\n\n    transform: none;\n\n}\n\n\n/* ================================================================\n   BOOKING MESSAGE\n================================================================ */\n\n.booking-message {\n\n    margin-top: 15px;\n\n}\n\n\n.booking-success {\n\n    padding:\n        12px 14px;\n\n    border-radius: 10px;\n\n    background:\n        rgba(34, 197, 94, 0.12);\n\n    border:\n        1px solid rgba(74, 222, 128, 0.25);\n\n    color:\n        #bbf7d0;\n\n    font-size: 13px;\n\n}\n\n\n/* ================================================================\n   REFRESH BUTTON\n================================================================ */\n\n.refresh-btn {\n\n    padding: 4px 8px;\n\n    border: 0;\n\n    background: transparent;\n\n    color:\n        #ddd6fe;\n\n    font-size: 12px;\n\n    font-weight: 600;\n\n    cursor: pointer;\n\n}\n\n\n.refresh-btn:hover {\n\n    color: #ffffff;\n\n    text-decoration: underline;\n\n}\n\n\n/* ================================================================\n   TABLE\n================================================================ */\n\n.customer-table-wrapper {\n\n    width: 100%;\n\n    overflow-x: auto;\n\n}\n\n\n.customer-table {\n\n    width: 100%;\n\n    min-width: 600px;\n\n    margin: 0;\n\n    border-collapse: collapse;\n\n}\n\n\n.customer-table thead {\n\n    background:\n        rgba(255, 255, 255, 0.06);\n\n}\n\n\n.customer-table th {\n\n    padding:\n        13px 15px;\n\n    border-bottom:\n        1px solid rgba(255, 255, 255, 0.10);\n\n    color:\n        rgba(255, 255, 255, 0.55);\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n    letter-spacing: 0.7px;\n\n    text-align: left;\n\n    text-transform: uppercase;\n\n    white-space: nowrap;\n\n}\n\n\n.customer-table td {\n\n    padding:\n        14px 15px;\n\n    border-bottom:\n        1px solid rgba(255, 255, 255, 0.07);\n\n    color:\n        rgba(255, 255, 255, 0.80);\n\n    font-size: 12px;\n\n    vertical-align: middle;\n\n}\n\n\n.customer-table tbody tr {\n\n    transition:\n        background 0.2s ease;\n\n}\n\n\n.customer-table tbody tr:hover {\n\n    background:\n        rgba(255, 255, 255, 0.05);\n\n}\n\n\n.customer-table tbody tr:last-child td {\n\n    border-bottom: 0;\n\n}\n\n\n/* ================================================================\n   TABLE EMPTY / LOADING\n================================================================ */\n\n.table-loading,\n.table-empty {\n\n    padding:\n        25px 15px !important;\n\n    color:\n        rgba(255, 255, 255, 0.48) !important;\n\n    text-align: center;\n\n}\n\n\n/* ================================================================\n   BOOKING ID\n================================================================ */\n\n.booking-id {\n\n    color:\n        #ddd6fe !important;\n\n    font-weight: 700;\n\n}\n\n\n/* ================================================================\n   STATUS BADGES\n================================================================ */\n\n.status-badge {\n\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    padding:\n        5px 9px;\n\n    border-radius: 999px;\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n    white-space: nowrap;\n\n}\n\n\n/* Applied */\n\n.status-applied {\n\n    background:\n        rgba(251, 191, 36, 0.15);\n\n    border:\n        1px solid rgba(251, 191, 36, 0.25);\n\n    color:\n        #fde68a;\n\n}\n\n\n/* Under Work */\n\n.status-work {\n\n    background:\n        rgba(96, 165, 250, 0.15);\n\n    border:\n        1px solid rgba(96, 165, 250, 0.25);\n\n    color:\n        #bfdbfe;\n\n}\n\n\n/* Confirmed */\n\n.status-confirmed {\n\n    background:\n        rgba(34, 197, 94, 0.15);\n\n    border:\n        1px solid rgba(74, 222, 128, 0.25);\n\n    color:\n        #bbf7d0;\n\n}\n\n\n/* Cancelled */\n\n.status-cancelled {\n\n    background:\n        rgba(239, 68, 68, 0.15);\n\n    border:\n        1px solid rgba(248, 113, 113, 0.25);\n\n    color:\n        #fecaca;\n\n}\n\n\n/* Rescheduled */\n\n.status-rescheduled {\n\n    background:\n        rgba(45, 212, 191, 0.15);\n\n    border:\n        1px solid rgba(94, 234, 212, 0.25);\n\n    color:\n        #99f6e4;\n\n}\n\n\n/* Default */\n\n.status-default {\n\n    background:\n        rgba(255, 255, 255, 0.10);\n\n    border:\n        1px solid rgba(255, 255, 255, 0.15);\n\n    color:\n        rgba(255, 255, 255, 0.70);\n\n}\n\n\n/* ================================================================\n   VEHICLE BADGE\n================================================================ */\n\n.vehicle-badge {\n\n    display: inline-block;\n\n    padding:\n        5px 8px;\n\n    border-radius: 7px;\n\n    background:\n        rgba(255, 255, 255, 0.07);\n\n    border:\n        1px solid rgba(255, 255, 255, 0.12);\n\n    color:\n        rgba(255, 255, 255, 0.78);\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n}\n\n\n/* ================================================================\n   INVOICE\n================================================================ */\n\n.invoice-link {\n\n    color:\n        #ddd6fe;\n\n    font-weight: 700;\n\n    text-decoration: none;\n\n}\n\n\n.invoice-link:hover {\n\n    color: #ffffff;\n\n    text-decoration: underline;\n\n}\n\n\n.invoice-total {\n\n    color:\n        #e9d5ff;\n\n}\n\n\n/* ================================================================\n   PROFILE MODAL\n================================================================ */\n\n.profile-modal {\n\n    overflow: hidden;\n\n    border:\n        1px solid rgba(255, 255, 255, 0.20);\n\n    border-radius: 18px;\n\n    background:\n        rgba(42, 16, 70, 0.96);\n\n    backdrop-filter:\n        blur(25px);\n\n    -webkit-backdrop-filter:\n        blur(25px);\n\n    box-shadow:\n        0 25px 70px rgba(0, 0, 0, 0.45);\n\n}\n\n\n.profile-modal .modal-header {\n\n    border-bottom:\n        1px solid rgba(255, 255, 255, 0.10);\n\n}\n\n\n.profile-modal .modal-title {\n\n    color: #ffffff;\n\n    font-weight: 700;\n\n}\n\n\n.profile-modal .modal-body {\n\n    padding: 22px;\n\n}\n\n\n.profile-modal .btn-close {\n\n    filter:\n        invert(1);\n\n}\n\n\n/* ================================================================\n   BOOTSTRAP ROW ADJUSTMENTS\n================================================================ */\n\n.customer-main-grid {\n\n    --bs-gutter-x: 1.5rem;\n\n    --bs-gutter-y: 1.5rem;\n\n}\n\n\n/* ================================================================\n   RESPONSIVE - TABLET\n================================================================ */\n\n@media (max-width: 991px) {\n\n    .customer-hero-content {\n\n        align-items: flex-start;\n\n        flex-direction: column;\n\n    }\n\n\n    .customer-hero-actions {\n\n        justify-content: flex-start;\n\n    }\n\n}\n\n\n/* ================================================================\n   RESPONSIVE - MOBILE\n================================================================ */\n\n@media (max-width: 576px) {\n\n    .customer-home-page {\n\n        padding:\n            15px 0 40px;\n\n    }\n\n\n    .customer-hero {\n\n        padding: 22px;\n\n        border-radius: 18px;\n\n    }\n\n\n    .customer-hero-text h2 {\n\n        font-size: 24px;\n\n    }\n\n\n    .customer-hero-text p {\n\n        font-size: 13px;\n\n    }\n\n\n    .customer-hero-actions {\n\n        width: 100%;\n\n        flex-direction: column;\n\n    }\n\n\n    .customer-btn {\n\n        width: 100%;\n\n    }\n\n\n    .customer-card {\n\n        border-radius: 16px;\n\n    }\n\n\n    .customer-card-header {\n\n        padding:\n            15px;\n\n    }\n\n\n    .customer-card-body {\n\n        padding:\n            16px;\n\n    }\n\n\n    .customer-table {\n\n        min-width: 650px;\n\n    }\n\n}', '__unsaved': 1}, 'action': 'Save', 'cmd': 'frappe.desk.form.save.savedocs'}
