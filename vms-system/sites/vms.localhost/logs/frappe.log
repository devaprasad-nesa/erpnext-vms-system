Form Dict: {'doc': {'docstatus': 0, 'doctype': 'Web Page', 'name': 'new-web-page-ugvvehhffa', '__islocal': 1, '__unsaved': 1, 'owner': 'Administrator', 'dynamic_route': 0, 'published': 1, 'content_type': 'HTML', 'dynamic_template': 0, 'page_blocks': [], 'insert_style': 0, 'text_align': 'Left', 'full_width': 1, 'show_title': 0, 'show_sidebar': 0, 'enable_comments': 0, 'title': 'my vehicles', 'module': 'Vms Vehicle', 'route': '/my-vehicles', 'main_section_html': '<div class="container my-5">\n\n    <div class="d-flex justify-content-between\n                align-items-center mb-4">\n\n        <div>\n            <h2>My Vehicles</h2>\n            <p class="text-muted">\n                View and manage your registered vehicles.\n            </p>\n        </div>\n\n        <a href="/vehicle-register"\n           class="btn btn-primary">\n            + Register New Vehicle\n        </a>\n\n    </div>\n\n    <div id="vehicle-list">\n        <p>Loading your vehicles...</p>\n    </div>\n\n</div>\n\n<script>\nfrappe.ready(function () {\n    loadMyVehicles();\n});\n\nfunction loadMyVehicles() {\n\n    frappe.call({\n        method: "vms_vehicle.api.get_my_vehicles",\n\n        callback: function (r) {\n\n            const container =\n                document.getElementById("vehicle-list");\n\n            if (r.exc) {\n                container.innerHTML = `\n                    <div class="alert alert-danger">\n                        Unable to load your vehicles.\n                    </div>\n                `;\n                return;\n            }\n\n            const vehicles = r.message || [];\n\n            if (vehicles.length === 0) {\n\n                container.innerHTML = `\n                    <div class="card p-5 text-center">\n\n                        <h4>No vehicles registered yet</h4>\n\n                        <p class="text-muted">\n                            Register your first vehicle\n                            to get started.\n                        </p>\n\n                        <div>\n                            <a href="/vehicle-register"\n                               class="btn btn-primary">\n                                Register Your First Vehicle\n                            </a>\n                        </div>\n\n                    </div>\n                `;\n\n                return;\n            }\n\n            container.innerHTML = `\n                <div class="row g-3">\n                    ${vehicles.map(vehicle => `\n                        <div class="col-md-6 col-lg-4">\n\n                            <div class="card h-100 p-3">\n\n                                <h4>\n                                    ${escapeHTML(\n                                        vehicle.vehicle_number\n                                    )}\n                                </h4>\n\n                                <p>\n                                    ${escapeHTML(\n                                        vehicle.vehicle_brand || ""\n                                    )}\n                                    ${escapeHTML(\n                                        vehicle.vehicle_model || ""\n                                    )}\n                                </p>\n\n                                <p class="text-muted">\n                                    ${escapeHTML(\n                                        vehicle.vehicle_type || ""\n                                    )}\n                                </p>\n\n                                <a\n                                    class="btn btn-outline-primary mt-auto"\n                                    href="/vehicle-details?name=${\n                                        encodeURIComponent(vehicle.name)\n                                    }">\n\n                                    View Details\n\n                                </a>\n\n                            </div>\n\n                        </div>\n                    `).join("")}\n                </div>\n            `;\n        }\n    });\n}\n\nfunction escapeHTML(value) {\n\n    return String(value)\n        .replace(/&/g, "&amp;")\n        .replace(/</g, "&lt;")\n        .replace(/>/g, "&gt;")\n        .replace(/"/g, "&quot;")\n        .replace(/\'/g, "&#039;");\n}\n</script>'}, 'action': 'Save', 'cmd': 'frappe.desk.form.save.savedocs'}
